# Copy to .env for local development. NEVER commit .env.
# Real keys live only here (local) or in your host's secret manager (production).
# Nothing in this file is ever sent to the browser.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info
APP_VERSION=dev

# Comma-separated exact origins allowed to call the API (no wildcards).
ALLOWED_ORIGINS=http://localhost:5173

# Supabase: use the NEW Curry project, not Mattchat's.
# Either the legacy anon/service_role keys or the newer publishable/secret keys work.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers: leave blank to disable a provider.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Billing (Phase 7). Test keys only outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
